# Cloudflare static-asset redirects.
# Docs: https://developers.cloudflare.com/workers/static-assets/redirects/
#
# Cloudflare already serves /privacy and /terms from the matching .html files.
# These explicit rules make the clean URLs the permanent (301) canonical
# versions, instead of relying on the default temporary redirect.
/index.html / 301
/privacy.html /privacy 301
/terms.html /terms 301
