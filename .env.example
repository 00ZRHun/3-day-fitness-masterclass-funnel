# Reservation delivery (serverless / production)
# Copy to .env.local for `vercel dev`, or add in Vercel → Project → Settings → Environment Variables.

# Recommended: any HTTPS endpoint that accepts JSON (Zapier, Make, Airtable,
# Google Apps Script, HubSpot, your CRM, etc.).
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Optional: transactional email through Resend (https://resend.com).
RESEND_API_KEY=
LEADS_EMAIL=hello@apexfitness.com
RESERVATION_FROM_EMAIL=ApexFitness <reservations@apexfitness.com>

# Send the athlete an immediate "request received" email. Requires a verified
# sending domain in Resend. Leave false to have only the admin notified.
SEND_LEAD_CONFIRMATION=false
