# Cloudflare Pages redirects.
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/
#
# Pages already serves /privacy and /terms from the matching .html files.
# These explicit rules make the clean URLs the permanent (301) canonical
# versions, instead of relying on Pages' default temporary (307) redirect.
/index.html / 301
/privacy.html /privacy 301
/terms.html /terms 301
