# Applied to both ./dist and the repository root. If Wrangler is ever
# auto-configured with ./ as the asset directory, these entries keep
# dependencies and private source out of the 25 MiB static asset upload.
# Docs: https://developers.cloudflare.com/workers/static-assets/binding/#ignoring-assets

.git/
.gitignore
.opencode/
.wrangler/
node_modules/
dist/
package.json
package-lock.json
wrangler.jsonc
worker.js
functions/
build.sh
README.md
.dev.vars*
.env*
_headers
_redirects
.assetsignore
*.py
__pycache__/
.DS_Store
*.log
