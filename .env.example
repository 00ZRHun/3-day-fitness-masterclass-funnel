# Reservation delivery (serverless / production)
#
# Vercel: copy to .env.local for `vercel dev`, or add in
#         Vercel → Project → Settings → Environment Variables.
# Cloudflare: add in Workers & Pages → your Worker/Pages project → Settings →
#             Variables and Secrets, or copy .dev.vars.example to .dev.vars for
#             local Wrangler development.

# Recommended: any HTTPS endpoint that accepts JSON (Zapier, Make, Airtable,
# Google Apps Script, HubSpot, your CRM, etc.).
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# Optional: transactional email through Resend (https://resend.com).
RESEND_API_KEY=
LEADS_EMAIL=hello@apexfitness.com
RESERVATION_FROM_EMAIL=ApexFitness <reservations@apexfitness.com>

# Send the athlete an immediate "request received" email. Requires a verified
# sending domain in Resend. Leave false to have only the admin notified.
SEND_LEAD_CONFIRMATION=false

# Cloudflare only: allow the reservation endpoint to return 201 with no delivery
# destination configured. Use only on a preview/test deployment. Never enable
# this on production, because the lead is not persisted anywhere.
ALLOW_UNCONFIGURED_LEADS=false
